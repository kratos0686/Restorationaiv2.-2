{
  "rules_blueprint": {
    "schema_version": "1.0",
    "collections": [
      {
        "name": "projects",
        "description": "Stores restoration projects and updates",
        "document_id": "projectId",
        "fields": [
          { "name": "companyId", "type": "string" },
          { "name": "client", "type": "string" },
          { "name": "statusUpdates", "type": "array" }
        ],
        "access_control": {
          "read": "request.auth != null",
          "write": "request.auth != null"
        }
      },
      {
        "name": "users",
        "description": "User profiles",
        "document_id": "userId",
        "fields": [
          { "name": "companyId", "type": "string" },
          { "name": "role", "type": "string" },
          { "name": "permissions", "type": "array" }
        ],
        "access_control": {
          "read": "request.auth != null",
          "write": "request.auth != null"
        }
      },
      {
        "name": "companies",
        "description": "Company records",
        "document_id": "companyId",
        "fields": [
          { "name": "name", "type": "string" }
        ],
        "access_control": {
          "read": "request.auth != null",
          "write": "request.auth != null"
        }
      }
    ]
  }
}
